<Window x:Class="WhisperTray.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whisper Tray"
        Width="430"
        Height="357"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A8A8A8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Path Data="M 10,10 L 22,22 M 22,10 L 10,22"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#303030" />
                                <Setter Property="Foreground" Value="#F0F0F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#E9E9E9" />
            <Setter Property="Foreground" Value="#181818" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F7F7F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D6D6D6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#2B2B2B" />
                                <Setter Property="Foreground" Value="#707070" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#303030" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#3A3A3A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#393939" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#707070" />
                                <Setter TargetName="Chrome" Property="Background" Value="#272727" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E2E2E2" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="#353535" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="#3D3D3D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0,30,0" />
            <Setter Property="Foreground" Value="#E2E2E2" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Field"
                                                Background="#242424"
                                                BorderBrush="#373737"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <TextBlock Margin="10,0,30,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#E2E2E2"
                                                           Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Path Margin="0,0,12,0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Data="M 0,0 L 4,4 L 8,0"
                                                      Stroke="#8D8D8D"
                                                      StrokeThickness="1.5" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Field" Property="BorderBrush" Value="#505050" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="#242424"
                                        BorderBrush="#3A3A3A"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C8C8C8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track"
                                    Width="34"
                                    Height="20"
                                    Background="#303030"
                                    BorderBrush="#484848"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Ellipse x:Name="Thumb"
                                         Width="12"
                                         Height="12"
                                         Margin="3"
                                         HorizontalAlignment="Left"
                                         Fill="#A8A8A8" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#686868" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#E8E8E8" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#E8E8E8" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#1C1C1C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F51B1B1B"
            BorderBrush="#343434"
            BorderThickness="1"
            CornerRadius="18"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.45" ShadowDepth="8" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="32" Height="32" Background="#2A2A2A" CornerRadius="9">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="2" Height="8" Margin="1,0" Background="#9B9B9B" CornerRadius="1" />
                        <Border Width="2" Height="14" Margin="1,0" Background="#EAEAEA" CornerRadius="1" />
                        <Border Width="2" Height="10" Margin="1,0" Background="#BDBDBD" CornerRadius="1" />
                        <Border Width="2" Height="16" Margin="1,0" Background="#EAEAEA" CornerRadius="1" />
                        <Border Width="2" Height="7" Margin="1,0" Background="#9B9B9B" CornerRadius="1" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Whisper" Foreground="#F1F1F1" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,2,0,0"
                               Text="Локальная транскрибация"
                               Foreground="#8E8E8E"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource CloseButtonStyle}"
                        AutomationProperties.Name="Скрыть"
                        Click="Hide_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <Border Padding="12,10" Background="#212121" BorderBrush="#303030" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="МОДЕЛЬ" Foreground="#777777" FontSize="10" FontWeight="SemiBold" />
                        <ComboBox x:Name="ModelComboBox"
                                  Margin="0,6,0,0"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource FieldComboBoxStyle}"
                                  AutomationProperties.Name="Модель Whisper"
                                  SelectionChanged="Settings_SelectionChanged" />
                    </StackPanel>
                </Border>

                <Border Margin="0,8,0,0" Padding="12,10" Background="#212121" BorderBrush="#303030" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="МИКРОФОН" Foreground="#777777" FontSize="10" FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="InputComboBox"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource FieldComboBoxStyle}"
                                      AutomationProperties.Name="Микрофон"
                                      SelectionChanged="Settings_SelectionChanged" />
                            <Button x:Name="MicrophoneTestButton"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Content="Проверить"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.Name="Проверить микрофон"
                                    Click="MicrophoneTest_Click" />
                        </Grid>
                        <ProgressBar x:Name="MicrophoneLevel"
                                     Height="4"
                                     Margin="0,10,0,0"
                                     Maximum="1"
                                     Background="#303030"
                                     Foreground="#E6E6E6" />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="AutostartCheckBox"
                          Margin="2,12,0,0"
                          Content="Запускать вместе с Windows"
                          Style="{StaticResource ToggleCheckBoxStyle}"
                          AutomationProperties.Name="Запускать вместе с Windows"
                          Click="Autostart_Click" />
            </StackPanel>

            <Button x:Name="RecordButton"
                    Grid.Row="2"
                    Margin="0,14,0,0"
                    Content="Начать транскрибацию"
                    Style="{StaticResource PrimaryButtonStyle}"
                    AutomationProperties.Name="Начать транскрибацию"
                    Click="RecordButton_Click" />
        </Grid>
    </Border>
</Window>
